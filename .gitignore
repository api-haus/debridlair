# Secrets
.env

# Your preferences — language, size ceilings, taste. Personal, so it must not
# collide with an upstream pull. The tracked template is PREFS.example.md.
PREFS.md
# Contents are secret (emby_api_key), but the watchlist is configuration and
# would otherwise be lost on a fresh clone. Needs the glob rather than a bare
# "sync-state/": git will not descend into an excluded directory to un-exclude
# a file inside it.
sync-state/*
!sync-state/watchlist.txt

# Runtime state / generated
emby/
prowlarr/
library/
rclone/

__pycache__/
*.pyc

# Project skills and the model pin ship with the repo; everything else under
# .claude/ is local agent state. The un-ignore of the directory has to come
# first — git will not descend into an excluded directory to re-include a file
# inside it — and it overrides a global core.excludesFile rule, which is where
# a personal ".claude/" usually lives.
!.claude/
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/skills/**
